@model CleanArchitecture.Models.Event
@using System.Globalization
@{
    ViewData["Title"] = "Shows que ficam";

    var culture = CultureInfo.GetCultureInfo("pt-BR");
    var eventDate = Model.StartsAt.ToString("dd MMM", culture).ToUpper(culture);
    var eventImage = string.IsNullOrWhiteSpace(Model.ImageUrl)
        ? "https://commons.wikimedia.org/wiki/Special:Redirect/file/Bruno_Mars_Concert_at_Singapore_06.jpg?width=2000"
        : Model.ImageUrl;
    var nameParts = Model.Name.Split(' ', 2, StringSplitOptions.RemoveEmptyEntries);
    var sectors = Model.Sectors.OrderBy(sector => sector.SectorId).ToList();
    var sectorClasses = new[] { "sector-north", "sector-west", "sector-east", "sector-south", "sector-floor", "sector-premium" };
    var lowestPrice = sectors.Count > 0 ? sectors.Min(sector => sector.Price) : 0;
}

<section class="hero" aria-labelledby="hero-title">
    <img class="hero-image" src="@eventImage" alt="@Model.Name no palco durante um show" fetchpriority="high" />
    <div class="hero-shade"></div>
    <div class="hero-content page-width">
        <p class="hero-label">Ao vivo em São Paulo</p>
        <h1 class="hero-title" id="hero-title">
            @foreach (var part in nameParts)
            {
                <span>@part</span>
            }
        </h1>
        <div class="hero-details">
            <p>@Model.Venue</p><p class="hero-date">@eventDate <span>•</span> @Model.StartsAt.ToString("HH:mm")</p>
        </div>
        <div class="hero-actions">
            <span class="ticket-button-wrap">
                <a class="button button-main ticket-button" href="#ingressos" data-ticket-button aria-label="Compre seu ingresso">
                    <span class="ticket-label">Compre seu ingresso</span>
                    <span class="ticket-loader" aria-hidden="true"></span>
                    <span class="ticket-check" aria-hidden="true">✓</span>
                    <span class="ticket-particles" aria-hidden="true"></span>
                </a>
            </span>
            <a class="button button-light" href="#eventos">Ver evento</a>
        </div>
    </div>
    <div class="hero-index" aria-hidden="true"><span>01</span><i></i><span>03</span></div>
    <a class="scroll-note" href="#eventos">Role para explorar <span aria-hidden="true">↓</span></a>
</section>

<section class="events section-space" id="eventos" aria-labelledby="events-title">
    <div class="page-width">
        <div class="section-heading reveal">
            <div><p class="eyebrow">Agenda</p><h2 id="events-title">Principais atrações</h2></div>
            <p class="artist-typing" aria-label="Bruno Mars, Macklemore e Skillet">
                <span>Em destaque</span><strong data-typewriter aria-hidden="true">Bruno Mars</strong><i aria-hidden="true"></i>
            </p>
        </div>
        <div class="event-list">
            <article class="event-card reveal">
                <a class="event-image" href="#ingressos" aria-label="Ver ingressos para @Model.Name">
                    <img src="@eventImage" alt="@Model.Name se apresentando ao vivo" loading="lazy" />
                    <span class="event-date"><strong>@Model.StartsAt.ToString("dd")</strong> @Model.StartsAt.ToString("MMM", culture).ToUpper(culture)</span><span class="event-arrow" aria-hidden="true">↗</span>
                </a>
                <div class="event-info"><div><h3>@Model.Name</h3><p>@Model.Venue</p></div><div class="event-price"><span>A partir de</span><strong>@lowestPrice.ToString("C", culture)</strong></div></div>
            </article>
            <article class="event-card reveal">
                <a class="event-image" href="#ingressos" aria-label="Ver ingressos para Macklemore">
                    <img src="https://commons.wikimedia.org/wiki/Special:Redirect/file/Macklemore_At_Key_Arena_In_Seattle_(54680386).jpeg?width=1200" alt="Macklemore em uma apresentação ao vivo" loading="lazy" />
                    <span class="event-date"><strong>09</strong> NOV</span><span class="event-arrow" aria-hidden="true">↗</span>
                </a>
                <div class="event-info"><div><h3>Macklemore</h3><p>Forge Arena <span>•</span> São Paulo</p></div><div class="event-price"><span>A partir de</span><strong>R$ 190</strong></div></div>
            </article>
            <article class="event-card reveal">
                <a class="event-image" href="#ingressos" aria-label="Ver ingressos para Skillet">
                    <img src="https://commons.wikimedia.org/wiki/Special:Redirect/file/Skillet,_Live!.jpg?width=1200" alt="A banda Skillet tocando ao vivo" loading="lazy" />
                    <span class="event-date"><strong>22</strong> NOV</span><span class="event-arrow" aria-hidden="true">↗</span>
                </a>
                <div class="event-info"><div><h3>Skillet</h3><p>Forge Arena <span>•</span> São Paulo</p></div><div class="event-price"><span>A partir de</span><strong>R$ 220</strong></div></div>
            </article>
        </div>
    </div>
</section>

<section class="venue section-space" id="ingressos" aria-labelledby="venue-title">
    <div class="page-width venue-layout">
        <div class="venue-copy reveal">
            <p class="eyebrow">@Model.Venue</p><h2 id="venue-title">Escolha<br />seu lugar</h2>
            <p>Veja os setores da arena e encontre o ponto de vista que combina com a sua noite.</p>
            <div class="seat-legend" aria-label="Legenda de disponibilidade">
                <span><i class="available"></i>Disponível</span><span><i class="reserved"></i>Reservado</span><span><i class="sold"></i>Vendido</span>
            </div>
        </div>
        <div class="venue-view reveal">
            <div class="venue-map" aria-label="Mapa ilustrativo dos setores de @Model.Venue" data-venue-map>
                <div class="stage"><span>Palco</span></div>
                @for (var index = 0; index < sectors.Count && index < sectorClasses.Length; index++)
                {
                    var sector = sectors[index];
                    <button class="sector @sectorClasses[index]" type="button" data-section="@sector.Name" data-sector-id="@sector.SectorId"><span>@sector.Name</span></button>
                }
                <div class="field-lines" aria-hidden="true"></div>
            </div>

            <div class="seat-map" data-seat-map hidden>
                <div class="seat-map-head">
                    <button class="back-button" type="button" data-back-button>← Voltar ao mapa</button>
                    <p><span>Setor</span><strong data-section-name>Leste</strong></p>
                </div>
                <div class="seat-stage"><span>Palco</span></div>
                <div class="seat-scroll">
                    <div class="seat-rows" data-seat-rows></div>
                </div>
                <div class="seat-info" aria-live="polite">
                    <span data-seat-section>Setor Leste</span>
                    <span data-seat-row>Fileira —</span>
                    <span data-seat-number>Cadeira —</span>
                    <span data-seat-message></span>
                </div>
            </div>

            @foreach (var sector in sectors)
            {
                <template data-sector-seats="@sector.SectorId">
                    @foreach (var row in sector.Seats.OrderBy(seat => seat.Row).ThenBy(seat => seat.Number).GroupBy(seat => seat.Row))
                    {
                        <div class="seat-row">
                            <span class="row-name">@row.Key</span>
                            @foreach (var seat in row)
                            {
                                var status = seat.Status.Trim().ToLowerInvariant();
                                var seatState = status is "sold" or "vendido" or "vendida"
                                    ? "sold"
                                    : status is "reserved" or "reservado" or "reservada"
                                        ? "reserved"
                                        : "available";
                                var statusLabel = seatState == "sold" ? "vendida" : seatState == "reserved" ? "reservada" : "disponível";

                                <button type="button"
                                        class="seat seat-@seatState"
                                        data-seat-id="@seat.SeatId"
                                        data-row="@seat.Row"
                                        data-number="@seat.Number.ToString("00")"
                                        aria-label="Fileira @seat.Row, cadeira @seat.Number, @statusLabel"
                                        disabled="@(seatState != "available")">@seat.Number</button>
                            }
                        </div>
                    }
                </template>
            }
        </div>
    </div>
</section>

<section class="buying section-space" aria-labelledby="steps-title">
    <div class="page-width">
        <div class="section-heading reveal"><div><p class="eyebrow">Do início ao ingresso</p><h2 id="steps-title">Simples em cada etapa</h2></div></div>
        <ol class="steps reveal">
            <li><span>01</span><strong>Escolha o show</strong></li><li><span>02</span><strong>Escolha seu lugar</strong></li>
            <li><span>03</span><strong>Finalize a compra</strong></li><li><span>04</span><strong>Receba seu ingresso</strong></li>
        </ol>
    </div>
</section>

<section class="show-banner reveal" aria-label="Experiência EventPass">
    <img src="https://commons.wikimedia.org/wiki/Special:Redirect/file/Millennium_stadium_concert.jpg?width=2000" alt="Público reunido em um grande show de estádio" loading="lazy" />
    <div class="show-banner-shade"></div><div class="show-banner-copy page-width"><p>Seu lugar.</p><p>Seu show.</p></div>
</section>
